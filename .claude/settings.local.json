{
  "permissions": {
    "allow": [
      "Bash(git cherry-pick *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit -m ' *)",
      "Bash(git mv *)",
      "Bash(gh api *)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "Bash(gh repo *)"
    ],
    "deny": [
      "Bash(git push*--no-verify*)",
      "Bash(git push*--force*)",
      "Bash(git push*-f *)",
      "Bash(git push*-f)",
      "Bash(git push*upstream*)"
    ]
  }
}
